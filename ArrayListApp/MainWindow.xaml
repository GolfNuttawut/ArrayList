<Window x:Class="ArrayListApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArrayListApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="Add" Content="Add" HorizontalAlignment="Left" Margin="100,0,0,0" VerticalAlignment="Center" Height="50" Width="152" Click="Add_Click"/>
        <Button x:Name="Remove" Content="Remove" HorizontalAlignment="Center" VerticalAlignment="Center" Height="50" Width="152" Click="Remove_Click"/>
        <Button x:Name="ShowAll" Content="Show All" HorizontalAlignment="Left" VerticalAlignment="Center" Height="50" Width="152" Margin="557,0,0,0" Click="ShowAll_Click"/>
        <TextBox x:Name="txtInput" HorizontalAlignment="Left" Margin="100,137,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="609" Height="28"/>
    </Grid>
</Window>
